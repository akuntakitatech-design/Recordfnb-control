# CATATAN: contoh workflow GitHub Actions (typecheck backend, typecheck + build frontend).
# Aktifkan dengan memindahkan berkas ini ke .github/workflows/ci.yml
# (PAT yang dipakai agent untuk PR tidak punya scope `workflow`, sehingga berkas workflow tidak bisa dipush otomatis).
#
# UAT end-to-end (butuh MariaDB + backend berjalan) dijalankan lewat `bash scripts/verify.sh`
# setelah `ADMIN_EMAIL`/`ADMIN_PASSWORD` diisi. Job CI untuk UAT belum disertakan di contoh ini.
name: School Control CI (monorepo)

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

jobs:
  backend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: yarn
          cache-dependency-path: backend/yarn.lock
      - run: yarn install --frozen-lockfile
      - name: Typecheck
        run: yarn typecheck

  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: yarn
          cache-dependency-path: frontend/yarn.lock
      - run: yarn install --frozen-lockfile
      - name: Typecheck
        run: yarn typecheck
      - name: Build
        run: yarn build
        env:
          CI: 'true'
