{
  "name": "akuntakita-fnb-control-api",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "description": "Akuntakita F&B Control - Backend API (Express + MariaDB + Cloudflare R2)",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-legacy": "tsx scripts/importLegacyData.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.0"
  }
}
