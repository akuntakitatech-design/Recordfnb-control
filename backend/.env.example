NODE_ENV=development
PORT=4100

# MariaDB
DATABASE_URL=mysql://school:password@127.0.0.1:3306/school_finance

# Sesi
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
COOKIE_NAME=school_session
COOKIE_SECURE=auto

# Admin awal (dibuat otomatis saat start bila belum ada)
BOOTSTRAP_ADMIN_EMAIL=admin@sekolah.test
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-ini
BOOTSTRAP_ADMIN_NAME=Administrator Sekolah

# OPSIONAL — hanya untuk memulihkan akses admin (lupa password / go-live).
# true = password admin direset dari BOOTSTRAP_ADMIN_PASSWORD dan pengguna wajib
# menggantinya saat login. HAPUS/nonaktifkan setelah satu kali start: selama aktif,
# password admin direset ulang pada setiap restart backend.
# Nilai yang diterima: 1 | true | yes (default: kosong = tidak reset)
BOOTSTRAP_ADMIN_RESET_PASSWORD=
