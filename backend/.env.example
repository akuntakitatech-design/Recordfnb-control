# ===== Akuntakita F&B Control — Backend env (Coolify) =====
# Salin nilai ke tab Environment Variables aplikasi backend di Coolify.

NODE_ENV=production
PORT=3000

# MariaDB (>= 10.5, direkomendasikan 11.x). Pakai host internal Coolify (tidak perlu port publik).
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE   (tambah ?ssl=true bila server mewajibkan TLS)
DATABASE_URL=mysql://mariadb:PASSWORD@nama-service-mariadb:3306/default
DB_POOL_SIZE=10

# Sesi (JWT di cookie httpOnly). Ganti dengan string acak panjang (>= 32 karakter).
JWT_SECRET=ganti-dengan-string-acak-panjang
COOKIE_NAME=fnb_session
# auto = flag Secure mengikuti protokol asli (HTTPS via Traefik). true/false untuk memaksa.
COOKIE_SECURE=auto

# Admin awal (dibuat bila belum ada; bila sudah ada -> hanya dipastikan is_system_admin, password lama dipertahankan)
BOOTSTRAP_ADMIN_EMAIL=agustrnt@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-kuat
BOOTSTRAP_ADMIN_NAME=Akuntakita Admin
# Set true SEKALI bila password admin lama perlu diganti dengan BOOTSTRAP_ADMIN_PASSWORD, lalu hapus lagi.
# BOOTSTRAP_ADMIN_RESET_PASSWORD=true

# Lampiran transaksi -> Cloudflare R2 (S3-compatible, bucket privat; file dialirkan lewat backend)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=<account id cloudflare>
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_BUCKET=media-recordfnb
# Opsional: semua objek diletakkan di bawah prefix ini
R2_PREFIX=attachments
# Alternatif bila tidak pakai R2_ACCOUNT_ID:
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com

# Fallback dev tanpa R2: STORAGE_DRIVER=local + UPLOAD_DIR
# STORAGE_DRIVER=local
# UPLOAD_DIR=/app/data/uploads
