# Admin awal (dibuat otomatis saat start bila belum ada)
BOOTSTRAP_ADMIN_EMAIL=admin@sekolah.test
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-ini
BOOTSTRAP_ADMIN_NAME=Administrator Sekolah
