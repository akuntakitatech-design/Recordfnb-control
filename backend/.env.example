NODE_ENV=development
PORT=4100

# MariaDB
DATABASE_URL=mysql://school:password@127.0.0.1:3306/school_finance

# Sesi
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
COOKIE_NAME=school_session
