PORT=3000
NODE_ENV=production

POSTGRES_DB=fnb_control_staging
POSTGRES_USER=fnb_staging_user
POSTGRES_PASSWORD=CHANGE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://fnb_staging_user:CHANGE_WITH_STRONG_DATABASE_PASSWORD@fnb-staging-db:5432/fnb_control_staging

JWT_SECRET=CHANGE_WITH_LONG_RANDOM_SECRET
COOKIE_NAME=fnb_staging_session

BOOTSTRAP_ADMIN_EMAIL=CHANGE_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Akuntakita Admin

# Network Caddy yang sudah berjalan bersama sistem kebun di VPS saat ini.
PROXY_NETWORK=02-vps-selfhost_kebun
